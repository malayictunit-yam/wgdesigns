# Required environment variables for Vercel deployments
# Copy these into your Vercel project settings (Dashboard → Project → Settings → Environment Variables).
# Do not commit real secret values to this file.

# === Public / Client build (Vite replaces these into the browser bundle) ===
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
# Optional: only needed if the client code starts referencing it directly.
VITE_SUPABASE_PROJECT_ID=your-project-id

# === Server-only / SSR / server functions ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: not currently used by app code, but present in Lovable Cloud secrets.
# SUPABASE_DB_URL=your-direct-connection-string

# === Lovable AI Gateway (admin-only feature) ===
LOVABLE_API_KEY=your-lovable-api-key
